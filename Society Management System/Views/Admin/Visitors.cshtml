@model IEnumerable<Society_Management_System.Models.Visitor>

@{
    ViewData["Title"] = "Visitor Management";
}

<div class="admin-container">
    <div class="admin-header">
        <h1><i class="bi bi-people-fill"></i> Visitor Management</h1>
        <p>Monitor and manage all society visitors in real-time.</p>
    </div>

    <div class="table-card">
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Visitor Name</th>
                    <th>Purpose</th>
                    <th>Contact Number</th>
                    <th>Visit Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="user-info">
                                <div class="avatar">@item.VisitorName[0]</div>
                                <span>@item.VisitorName</span>
                            </div>
                        </td>
                        <td>@item.Purpose</td>
                        <td>@item.ContactNumber</td>
                        <td>@item.RequestDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="status-badge active">Checked In</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    :root {
        --primary: #0d2f5b;
        --secondary: #f3c74d;
        --accent: #eac461;
        --bg: #f8f9fa;
        --text: #333;
        --white: #ffffff;
        --shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .admin-container {
        padding: 40px;
        background: var(--bg);
        min-height: 80vh;
    }

    .admin-header {
        margin-bottom: 30px;
        border-left: 5px solid var(--secondary);
        padding-left: 20px;
    }

    .admin-header h1 {
        color: var(--primary);
        font-size: 2.5rem;
        margin: 0;
        font-weight: 700;
    }

    .admin-header p {
        color: #666;
        margin-top: 5px;
    }

    .table-card {
        background: var(--white);
        border-radius: 15px;
        padding: 20px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .premium-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    .premium-table th {
        text-align: left;
        padding: 15px;
        background: var(--primary);
        color: var(--white);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 1px;
    }

    .premium-table td {
        padding: 15px;
        border-bottom: 1px solid #eee;
        color: var(--text);
        font-size: 1rem;
    }

    .premium-table tr:hover {
        background: #fcfcfc;
        transform: scale(1.002);
        transition: all 0.2s ease;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar {
        width: 35px;
        height: 35px;
        background: var(--accent);
        color: var(--primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-badge.active {
        background: #e8f5e9;
        color: #2e7d32;
    }
</style>
