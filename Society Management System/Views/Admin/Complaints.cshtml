@model IEnumerable<Society_Management_System.Models.Complaint>

@{
    ViewData["Title"] = "Complaint Management";
}

<div class="admin-container">
    <div class="admin-header">
        <h1><i class="bi bi-exclamation-triangle-fill"></i> Complaint Management</h1>
        <p>Track and resolve resident complaints efficiently.</p>
    </div>

    <div class="table-card">
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-weight: 600; color: var(--primary);">@item.Title</td>
                        <td>
                            <div class="truncate-text" title="@item.Description">
                                @item.Description
                            </div>
                        </td>
                        <td>
                            <span class="status-badge @item.Status.ToLower().Replace(" ", "-")">
                                @item.Status
                            </span>
                        </td>
                        <td>@item.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <button class="action-btn"><i class="bi bi-pencil-square"></i> Update</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    :root {
        --primary: #0d2f5b;
        --secondary: #f3c74d;
        --accent: #eac461;
        --bg: #f8f9fa;
        --text: #333;
        --white: #ffffff;
        --shadow: 0 10px 30px rgba(0,0,0,0.1);
        --pending: #fff3e0;
        --pending-text: #ef6c00;
        --resolved: #e8f5e9;
        --resolved-text: #2e7d32;
        --in-progress: #e3f2fd;
        --in-progress-text: #1565c0;
    }

    .admin-container {
        padding: 40px;
        background: var(--bg);
        min-height: 80vh;
    }

    .admin-header {
        margin-bottom: 30px;
        border-left: 5px solid var(--secondary);
        padding-left: 20px;
    }

    .admin-header h1 {
        color: var(--primary);
        font-size: 2.5rem;
        margin: 0;
        font-weight: 700;
    }

    .admin-header p {
        color: #666;
        margin-top: 5px;
    }

    .table-card {
        background: var(--white);
        border-radius: 15px;
        padding: 20px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .premium-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    .premium-table th {
        text-align: left;
        padding: 15px;
        background: var(--primary);
        color: var(--white);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 1px;
    }

    .premium-table td {
        padding: 15px;
        border-bottom: 1px solid #eee;
        color: var(--text);
    }

    .truncate-text {
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-badge.pending { background: var(--pending); color: var(--pending-text); }
    .status-badge.resolved { background: var(--resolved); color: var(--resolved-text); }
    .status-badge.in-progress { background: var(--in-progress); color: var(--in-progress-text); }

    .action-btn {
        background: var(--primary);
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        transition: all 0.3s;
    }

    .action-btn:hover {
        background: var(--secondary);
        color: var(--primary);
    }
</style>
