@model Society_Management_System.Models.Maintenance
@{
    ViewData["Title"] = "Add Maintenance Bill";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4>Add Maintenance Bill</h4>
            </div>
            <div class="card-body">
                <form asp-action="AddMaintenance" method="post">
                    <div class="mb-3">
                        <label class="form-label">Select User</label>
                        <select asp-for="UserId" class="form-select" required>
                            @foreach (var user in ViewBag.Users)
                            {
                                <option value="@user.UserId">@user.Name (@user.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="DueDate" class="form-label"></label>
                        <input asp-for="DueDate" class="form-control" type="date" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Unpaid">Unpaid</option>
                            <option value="Paid">Paid</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Create Bill</button>
                </form>
            </div>
        </div>
    </div>
</div>
