@model IEnumerable<Society_Management_System.Models.HallBooking>

@{
    ViewData["Title"] = "Hall Bookings";
}

<div class="admin-container">
    <div class="admin-header">
        <h1><i class="bi bi-calendar-check-fill"></i> Hall Bookings</h1>
        <p>Manage community hall reservations and schedules.</p>
    </div>

    <div class="booking-grid">
        @foreach (var item in Model)
        {
            <div class="booking-card">
                <div class="booking-type">@item.HallType</div>
                <div class="booking-date"><i class="bi bi-calendar3"></i> @item.Date.ToString("MMMM dd, yyyy")</div>
                <div class="booking-time">
                    <i class="bi bi-clock"></i> @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")
                </div>
                <div class="booking-purpose">
                    <strong>Purpose:</strong> @item.Purpose
                </div>
                <div class="booking-footer">
                    <span class="status-tag">Confirmed</span>
                    <button class="details-btn">View Details</button>
                </div>
            </div>
        }
    </div>
</div>

<style>
    :root {
        --primary: #0d2f5b;
        --secondary: #f3c74d;
        --accent: #eac461;
        --bg: #f8f9fa;
        --white: #ffffff;
        --shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .admin-container {
        padding: 40px;
        background: var(--bg);
        min-height: 80vh;
    }

    .admin-header {
        margin-bottom: 40px;
        border-left: 5px solid var(--secondary);
        padding-left: 20px;
    }

    .admin-header h1 {
        color: var(--primary);
        font-size: 2.5rem;
        margin: 0;
    }

    .booking-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
    }

    .booking-card {
        background: var(--white);
        border-radius: 20px;
        padding: 25px;
        box-shadow: var(--shadow);
        transition: transform 0.3s ease;
        border: 1px solid #eee;
    }

    .booking-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.12);
    }

    .booking-type {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .booking-date, .booking-time {
        margin-bottom: 10px;
        color: #555;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .booking-purpose {
        margin: 20px 0;
        padding-top: 15px;
        border-top: 1px dashed #eee;
        color: #666;
        font-style: italic;
    }

    .booking-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
    }

    .status-tag {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 5px 12px;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .details-btn {
        background: none;
        border: 1px solid var(--primary);
        color: var(--primary);
        padding: 6px 15px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s;
    }

    .details-btn:hover {
        background: var(--primary);
        color: white;
    }
</style>
