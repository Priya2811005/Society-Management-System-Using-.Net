@{
    ViewData["Title"] = "Complaint Management";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<style>
    .page-wrapper {
        padding: 20px;
    }

    .card {
        background: #fff;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }

    .tabs {
        display: flex;
        margin-bottom: 20px;
    }

        .tabs a {
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 6px 6px 0 0;
            margin-right: 5px;
        }

    .tab-active {
        background-color: #0d3b66;
        color: #fff;
    }

    .tab-inactive {
        background-color: #e0e0e0;
        color: #000;
    }

    .form-box {
        border: 1px solid #ddd;
        padding: 20px;
        border-radius: 8px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    input, textarea {
        width: 100%;
        padding: 10px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }

    .btn-submit {
        background-color: #0d3b66;
        color: white;
        padding: 10px 25px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }

    .preview-img {
        margin-top: 10px;
        width: 200px;
        border-radius: 6px;
        display: none;
    }
</style>

<div class="page-wrapper">

    <div class="card">

        <!-- Tabs -->
        <div class="tabs">
            <a href="/Complaint/AddComplaint" class="tab-active">Complaint Form</a>
            <a href="/Complaint/List" class="tab-inactive">Complaint List</a>
        </div>

        <!-- Header -->
        <h3>Complaint Management</h3>
        <p>Submit and manage your visitor requests.</p>

        <h4>Add Complaint</h4>

        @using (Html.BeginForm("AddComplaint", "Complaint", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div class="form-box">

                <!-- Date -->
                <div class="form-group">
                    <label>Complaint Date</label>
                    <input type="date" name="ComplaintDate" required />
                </div>

                <!-- Description -->
                <div class="form-group">
                    <label>Description</label>
                    <textarea name="Description" rows="4" placeholder="Type Description Here"></textarea>
                </div>

                <!-- Upload -->
                <div class="form-group">
                    <label>Upload Image</label>
                    <input type="file" name="ImageFile" onchange="previewImage(this)" />
                    <img id="imgPreview" class="preview-img" />
                </div>

                <!-- Submit -->
                <button type="submit" class="btn-submit">Submit Request</button>

            </div>
        }
    </div>
</div>

<script>
    function previewImage(input) {
        var preview = document.getElementById("imgPreview");
        var file = input.files[0];
        var reader = new FileReader();

        reader.onloadend = function () {
            preview.src = reader.result;
            preview.style.display = "block";
        }

        if (file) {
            reader.readAsDataURL(file);
        }
    }
</script>