@{
    ViewData["Title"] = "Contact Us";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css">

<div id="contactUs" class="container my-5">

    <!-- Title -->
    <h2 class="text-center fw-bold mb-2" data-aos="fade-up">
        Contact Us
    </h2>

    <p class="text-center text-muted mb-4" data-aos="fade-up" data-aos-delay="200">
        Get in touch with us for any inquiries or assistance
    </p>

    <div class="row">

        <!-- LEFT SIDE CARDS -->

        <div class="col-md-6">

            <div class="row">

                <!-- Address -->
                <div class="col-md-6 mb-4" data-aos="flip-left" data-aos-delay="300">
                    <div class="card border-0 shadow-sm h-100 text-center p-3">
                        <div class="card-body">
                            <div class="display-5 mb-2 text-primary">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <h5>Address</h5>
                            <p class="text-muted">
                                Street 7, Main Jaljit Society,
                                Near Mavdi, 150ft Ring Road,
                                Rajkot - 360001
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Email -->
                <div class="col-md-6 mb-4" data-aos="flip-left" data-aos-delay="400">
                    <div class="card border-0 shadow-sm h-100 text-center p-3">
                        <div class="card-body">
                            <div class="display-5 mb-2 text-danger">
                                <i class="bi bi-envelope-fill"></i>
                            </div>
                            <h5>Email</h5>
                            <p class="text-muted">rnv1924@gmail.com</p>
                        </div>
                    </div>
                </div>

            </div>

            <div class="row">

                <!-- Phone -->
                <div class="col-md-6 mb-4" data-aos="flip-left" data-aos-delay="500">
                    <div class="card border-0 shadow-sm h-100 text-center p-3">
                        <div class="card-body">
                            <div class="display-5 mb-2 text-success">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <h5>Phone</h5>
                            <p class="text-muted">+91 7984767883</p>
                        </div>
                    </div>
                </div>

                <!-- Open Hours -->
                <div class="col-md-6 mb-4" data-aos="flip-left" data-aos-delay="600">
                    <div class="card border-0 shadow-sm h-100 text-center p-3">
                        <div class="card-body">
                            <div class="display-5 mb-2 text-info">
                                <i class="bi bi-clock"></i>
                            </div>
                            <h5>Open Hours</h5>
                            <p class="text-muted">
                                Monday - Friday<br>
                                9:00 AM to 5:00 PM
                            </p>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <!-- RIGHT SIDE FORM -->

        <div class="col-md-6" data-aos="fade-up" data-aos-delay="700">

            <div class="card p-4 border-0" style="background:#052C65;color:white">

                <h4 class="text-center mb-4">Send a Message</h4>

                <form asp-action="SendMessage" method="post">

                    <div class="mb-3">
                        <label>Name</label>
                        <input type="text" name="Name" class="form-control" placeholder="Your Name">
                    </div>

                    <div class="mb-3">
                        <label>Email</label>
                        <input type="email" name="Email" class="form-control" placeholder="Your Email">
                    </div>

                    <div class="mb-3">
                        <label>Message</label>
                        <textarea name="Message" rows="4" class="form-control" placeholder="Your Message"></textarea>
                    </div>

                    <button type="submit" class="btn btn-outline-light w-100">
                        Send Message
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>

<script>
    AOS.init({
        duration: 1000
    });
</script>