@{
    ViewBag.Title = "Hall Booking";
    Layout = "~/Views/Shared/UserLayout.cshtml";
}

<style>
    body {
        background-color: #f4f7fb;
    }

    .page-title {
        font-weight: 700;
        font-size: 26px;
        color: #0f2f5f;
    }

    .sub-text {
        color: #6c757d;
        font-size: 14px;
    }

    .side-btn {
        width: 100%;
        margin-bottom: 12px;
        border-radius: 10px;
        font-weight: 600;
        padding: 12px;
    }

    .btn-primary {
        background-color: #0f2f5f;
        border: none;
    }

    .btn-outline-primary {
        border-color: #0f2f5f;
        color: #0f2f5f;
    }

    .form-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    }

    .form-control {
        border-radius: 8px;
        font-size: 14px;
        padding: 10px;
    }

    label {
        font-weight: 500;
    }

    .submit-btn {
        background-color: #0f2f5f;
        color: white;
        border-radius: 8px;
        padding: 10px 25px;
    }
</style>

<div class="container-fluid mt-3">

    <!-- Heading -->
    <div class="mb-4">
        <div class="page-title">Community Hall Booking</div>
        <div class="sub-text">Easily manage and book halls for your events</div>
    </div>

    <div class="row">

        <!-- Left Buttons -->
        <div class="col-md-3">
            <a href="#" class="btn btn-primary side-btn">Booking Form</a>
        </div>

        <!-- Form Section -->
        <div class="col-md-7">
            <div class="form-card">

                <h4 class="fw-bold mb-4">Hall Booking Form</h4>
                @model Society_Management_System.Models.HallBooking


                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                <form asp-action="SaveHallBooking" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Hall Type -->
                    <div class="mb-3">
                        <label>Hall Type</label>
                        <select asp-for="HallType" class="form-control">
                            <option value="">-- Select Hall --</option>
                            <option>Hall A (Capacity: 50)</option>
                            <option>Hall B (Capacity: 100)</option>
                            <option>Hall C (Capacity: 200)</option>
                        </select>
                    </div>

                    <!-- Date -->
                    <div class="mb-3">
                        <label>Date</label>
                        <input asp-for="BookingDate" type="date" class="form-control" />
                    </div>

                    <!-- Time -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Start Time</label>
                            <input asp-for="StartTime" type="time" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>End Time</label>
                            <input asp-for="EndTime" type="time" class="form-control" />
                        </div>
                    </div>

                    <!-- Purpose -->
                    <div class="mb-3">
                        <label>Purpose</label>
                        <textarea asp-for="Purpose" class="form-control"></textarea>
                    </div>

                    <!-- Submit -->
                    <div class="text-center mt-4">
                        <button type="submit" class="submit-btn">Submit Request</button>
                    </div>

                </form>

            </div>
        </div>

    </div>

</div>