@{
ViewData["Title"] = "Maintenance Dashboard";
Layout = "~/Views/Shared/UserLayout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f4f6f9;
        font-family: 'Segoe UI', sans-serif;
    }

    .dashboard-title {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .card-box {
        background: #fff;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
        border: 1px solid #ddd;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .section-title {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .alert-custom {
        background-color: #b9e3ea;
        color: #0c5460;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #9bd3dc;
    }
</style>

<div class="container mt-4">

    <!-- Page Title -->
    <div class="dashboard-title">Maintenance Dashboard</div>

    <!-- Pending Maintenance -->
    <div class="card-box">
        <div class="section-title">Pending Maintenance</div>

        <div class="alert-custom">
            No pending payments
        </div>
    </div>

    <!-- Payment History -->
    <div class="card-box">
        <div class="section-title">Payment History</div>

        <div class="alert-custom">
            No payment history
        </div>
    </div>

</div>