@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/UserLayout.cshtml";
}

<div class="dashboard-container">

    <h1>Dashboard</h1>
    <p>Welcome to your Society Management Panel</p>

    <div class="cards">

        <div class="card">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <h3>Complaints</h3>
            <p>Raise and track your complaints</p>
            <a asp-controller="Complaint" asp-action="Index" class="btn">Go</a>
        </div>

        <div class="card">
            <i class="fa-solid fa-bullhorn"></i>
            <h3>Notices</h3>
            <p>View latest society updates</p>
            <a asp-controller="Notice" asp-action="Index">
        </div>

        <div class="card">
            <i class="fa-solid fa-user-check"></i>
            <h3>Visitors</h3>
            <p>Manage your visitors</p>
            <a asp-controller="Visitor" asp-action="Index" class="btn">Go</a>
        </div>

    </div>

</div>