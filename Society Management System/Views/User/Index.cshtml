
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}




<div class="container py-4">

    <!-- Title -->
    <h2 class="fw-bold">Complaint Management</h2>
    <p class="text-muted">Manage and track complaints easily.</p>

    <!-- Complaint Cards -->
    <div class="row g-4 mt-2">

        <!-- Card 1 -->
        <div class="col-md-4">
            <div class="card complaint-card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold">Rahul Shah</h5>
                    <p class="mb-1">Flat: 101</p>
                    <p class="mb-1">Issue: Water leakage</p>
                    <span class="badge bg-warning text-dark">Pending</span>

                    <div class="mt-3">
                        <button class="btn btn-sm btn-primary">Resolve</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="col-md-4">
            <div class="card complaint-card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold">Priya Patel</h5>
                    <p class="mb-1">Flat: 102</p>
                    <p class="mb-1">Issue: Lift not working</p>
                    <span class="badge bg-info text-dark">In Progress</span>

                    <div class="mt-3">
                        <button class="btn btn-sm btn-primary">Resolve</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="col-md-4">
            <div class="card complaint-card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold">Amit Kumar</h5>
                    <p class="mb-1">Flat: 103</p>
                    <p class="mb-1">Issue: Electric issue</p>
                    <span class="badge bg-success">Resolved</span>

                    <div class="mt-3">
                        <button class="btn btn-sm btn-secondary">Done</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="col-md-4">
            <div class="card complaint-card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold">Neha Joshi</h5>
                    <p class="mb-1">Flat: 104</p>
                    <p class="mb-1">Issue: Parking issue</p>
                    <span class="badge bg-warning text-dark">Pending</span>

                    <div class="mt-3">
                        <button class="btn btn-sm btn-primary">Resolve</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Sidebar Active Highlight -->
<script>
    document.querySelectorAll('.sidebar ul li a').forEach(function (item) {
        item.classList.remove('active');

        if (item.textContent.includes("Complain")) {
            item.classList.add('active');
        }
    });
</script>

<!-- Custom CSS -->
<style>
    .complaint-card {
        border-radius: 12px;
        transition: 0.3s;
    }

        .complaint-card:hover {
            transform: translateY(-5px);
        }

    .badge {
        font-size: 0.85rem;
        padding: 6px 10px;
        border-radius: 8px;
    }
</style>

