@{
    ViewData["Title"] = "Password Reset Successful";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>

    .theme-color {
        color: #173b63;
    }

    .btn-theme {
        background-color: #173b63;
        border: none;
        color: white;
        font-weight: 500;
    }

        .btn-theme:hover {
            background-color: #0f2a47;
        }

    .success-card {
        width: 500px;
        border-radius: 12px;
    }


</style>

<div class="container d-flex justify-content-center align-items-center" style="height:100vh;">

    <div class="card shadow p-4 text-center success-card">

        <!-- Logo -->
        <div class="logo-section"> 
            <img src="~/images/logo.png" alt="T2P Estate Logo"> 
            </div>

        <h3 class="theme-color mb-3">Password Reset Successfully</h3>

        <p class="text-muted">
            Your password has been updated successfully.
            You can now login with your new password.
        </p>

        <a href="/Account/Login" class="btn btn-theme w-100 mt-3">
            Go to Login
        </a>

    </div>

</div>