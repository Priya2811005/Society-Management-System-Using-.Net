@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";

}


@{
    ViewData["Title"] = "Reset Password";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>

    .theme-color {
        color: #173b63;
    }

    .btn-theme {
        background-color: #173b63;
        border: none;
        color: white;
        font-weight: 500;
    }

        .btn-theme:hover {
            background-color: #0f2a47;
        }

    .reset-card {
        width: 400px;
        border-radius: 12px;
    }

</style>

<div class="container d-flex justify-content-center align-items-center" style="height:100vh;">

    <div class="card shadow p-4 reset-card">

        <h3 class="text-center mb-4 theme-color">Reset Password</h3>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">
                @ViewBag.Message
            </div>
        }

        <form asp-controller="Account" asp-action="ResetPassword" method="post">

            <div class="mb-3">
                <label class="form-label theme-color">New Password</label>
                <input type="password" name="password" class="form-control" placeholder="Enter new password" required />
            </div>

            <div class="mb-3">
                <label class="form-label theme-color">Confirm Password</label>
                <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm new password" required />
            </div>

            <button type="submit" class="btn btn-theme w-100">
                Reset Password
            </button>

        </form>

        <div class="text-center mt-3">
            <a href="/Account/Login" class="text-decoration-none theme-color">
                ← Back to Login
            </a>
        </div>

    </div>

</div>