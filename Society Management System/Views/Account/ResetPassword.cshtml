@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Reset Password - T2P</title>

    <link rel="stylesheet" href="~/css/landingstyle.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>

        body {
            background: #f5f7fb;
            height: 100vh;
        }

        .left-section {
            background: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .form-box {
            width: 100%;
            max-width: 400px;
        }

        .btn-primary-custom {
            background-color: #052C65;
            border: none;
        }

            .btn-primary-custom:hover {
                background-color: #031f45;
            }

        .right-section {
            background: #eef2f7;
        }

    </style>
</head>

<body>

    <div class="container-fluid p-0 vh-100">

        <!-- Top bar -->
        <div style="height:20px;background:#052C65;"></div>

        <div class="row g-0 h-100">

            <!-- Left Side -->
            <div class="col-md-6 left-section">

                <img src="~/images/logo.png" style="width:200px;" class="mb-4" />

                <div class="form-box">

                    <h3 class="text-center mb-2">Reset Password</h3>

                    <p class="text-center text-muted mb-4">
                        Enter your new password below
                    </p>

                    <form asp-controller="Account" asp-action="ResetPassword" method="post">

                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input type="password"
                                   name="NewPassword"
                                   class="form-control"
                                   placeholder="Enter new password"
                                   required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Confirm Password</label>
                            <input type="password"
                                   name="ConfirmPassword"
                                   class="form-control"
                                   placeholder="Confirm new password"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary-custom text-white w-100">
                            Reset Password
                        </button>

                    </form>

                    <div class="text-center mt-3">
                        <a asp-controller="Account"
                           asp-action="Forget"
                           class="text-muted text-decoration-none">
                            ← Back
                        </a>
                    </div>

                </div>

            </div>


            <!-- Right Side -->
            <div class="col-md-6 right-section d-flex justify-content-center align-items-center">

                <div class="text-center px-5">

                    <img src="~/images/login.png"
                         class="img-fluid mb-4"
                         style="max-width:75%;" />

                    <h4 class="fw-bold">Efficient Living Starts Here</h4>

                    <p class="text-muted">
                        Our platform is built to meet the needs of apartment communities
                        with intuitive, practical, and accessible features.
                    </p>

                    <p class="text-muted small mt-4">
                        © 2026 T2P • Designed by T2P
                    </p>

                </div>

            </div>

        </div>

    </div>

</body>
</html>