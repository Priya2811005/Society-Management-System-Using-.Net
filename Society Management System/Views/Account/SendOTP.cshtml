@{
    ViewData["Title"] = "OTP Sent";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container d-flex justify-content-center align-items-center" style="height:100vh; background:#f5f7fb;">

    <div class="card shadow-lg border-0 p-4 text-center" style="width:420px; border-radius:12px;">

        <img src="~/images/logo.png" style="width:120px;" class="mb-3" />

        <h3 class="fw-bold mb-2">OTP Sent Successfully</h3>

        <p class="text-muted">
            We have sent a One-Time Password (OTP) to your registered email.
            Please check your inbox and enter the OTP to reset your password.
        </p>

        <a href="/Account/VerifyOTP"
           class="btn btn-lg mt-3"
           style="background:#052C65;color:white;">
            Verify OTP
        </a>

        <div class="mt-3">
            <a href="/Account/Login" class="text-decoration-none text-muted">
                ← Back to Login
            </a>
        </div>

    </div>

</div>