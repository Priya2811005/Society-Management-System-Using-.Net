@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>

    body {
        background: linear-gradient(135deg,#f5f7fb,#eef2f7);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .top-bar {
        height: 18px;
        background: #052C65;
    }

    .forgot-card {
        width: 420px;
        border-radius: 14px;
        padding: 35px;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .form-control {
        border-radius: 8px;
        padding: 12px;
    }

        .form-control:focus {
            border-color: #052C65;
            box-shadow: 0 0 0 0.15rem rgba(5,44,101,.15);
        }

    .btn-primary-custom {
        background: #052C65;
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-weight: 600;
    }

        .btn-primary-custom:hover {
            background: #041f48;
        }

    .right-section {
        background: #f8f9fc;
    }

    .logo {
        width: 110px;
    }

    .illustration {
        max-width: 420px;
    }

</style>

<div class="container-fluid p-0 min-vh-100">

    <!-- Top Bar -->
    <div class="top-bar w-100"></div>

    <div class="row g-0 min-vh-100">

        <!-- LEFT SIDE -->
        <div class="col-md-6 d-flex justify-content-center align-items-center">

            <div class="forgot-card">

                <div class="text-center mb-4">
                    <img src="~/images/logo.png" class="logo mb-3" />

                    <h3 class="fw-bold">Forgot Password</h3>

                    <p class="text-muted small">
                        Enter your registered email address and we'll send you an OTP to reset your password.
                    </p>
                </div>

                <!-- Success -->
                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success">
                        @ViewBag.Success
                    </div>
                }

                <!-- Error -->
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                <form asp-controller="Account" asp-action="SendOTP" method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Email Address
                        </label>

                        <input type="email"
                               name="email"
                               class="form-control"
                               placeholder="Enter your email address"
                               required />

                    </div>

                    <button type="submit"
                            class="btn btn-primary-custom text-white w-100 mt-2">
                        Send OTP
                    </button>

                </form>

                <div class="text-center mt-4">

                    <a href="/Account/Login"
                       class="text-decoration-none text-muted">

                        ← Back to Login

                    </a>

                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="col-md-6 right-section d-flex justify-content-center align-items-center">

            <div class="text-center px-5">

                <img src="~/images/login.png"
                     class="img-fluid illustration mb-4" />

                <h3 class="fw-bold mb-2">
                    Efficient Living Starts Here
                </h3>

                <p class="text-muted">
                    Our platform helps apartment communities manage residents,
                    services, and facilities with intuitive and practical tools.
                </p>

                <p class="text-muted small mt-4">
                    © 2026 T2P • Designed by T2P
                </p>

            </div>

        </div>

    </div>

</div>