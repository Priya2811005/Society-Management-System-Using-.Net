@{
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet" href="~/css/landingstyle.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container-fluid p-0" style="min-height:100vh; background:#f5f7fb;">

    <!-- Top Bar -->
    <div class="w-100" style="height:18px; background:#052C65;"></div>

    <div class="row g-0 min-vh-100">

        <!-- LEFT SIDE -->
        <div class="col-md-6 d-flex justify-content-center align-items-center bg-white">

            <div class="card shadow-lg border-0 p-4" style="width:420px; border-radius:12px;">

                <div class="text-center mb-3">
                    <img src="~/images/logo.png" style="width:120px;" class="mb-2" />
                    <h3 class="fw-bold">Forgot Password</h3>
                    <p class="text-muted small">
                        Enter your registered email to receive OTP
                        for resetting your password.
                    </p>
                </div>

                <!-- Success -->
                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success">
                        @ViewBag.Success
                    </div>
                }

                <!-- Error -->
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                <!-- FORM -->
                <form asp-controller="Account" asp-action="SendOTP" method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>

                        <input type="email"
                               name="email"
                               class="form-control form-control-lg"
                               placeholder="Enter your email"
                               required />
                    </div>

                    <button type="submit"
                            class="btn btn-lg w-100 mt-2"
                            style="background:#052C65;color:white;">
                        Send OTP
                    </button>

                </form>

                <div class="text-center mt-3">
                    <a href="/Account/Login" class="text-decoration-none text-muted">
                        ← Back to Login
                    </a>
                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="col-md-6 d-flex justify-content-center align-items-center bg-light">

            <div class="text-center px-5">

                <img src="~/images/login.png"
                     class="img-fluid mb-4"
                     style="max-width:420px;" />

                <h3 class="fw-bold mb-2">
                    Efficient Living Starts Here
                </h3>

                <p class="text-muted">
                    Our platform helps manage apartment communities
                    with intuitive, practical, and accessible features.
                </p>

                <p class="text-muted small mt-4">
                    © 2023 RNV • Designed by RNV
                </p>

            </div>

        </div>

    </div>

</div>