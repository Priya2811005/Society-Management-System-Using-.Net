@{
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center">

    <div class="row w-100">

        <!-- Left Side -->
        <div class="col-md-6 d-flex flex-column justify-content-center align-items-center bg-light p-5">

            <img src="~/images/email.png" class="img-fluid" style="max-height:400px;" />

            <h2 class="mt-4 text-center">Forgot Your Password?</h2>

            <p class="text-center text-muted">
                Enter your registered email and we will send you an OTP
                to reset your password securely.
            </p>

        </div>


        <!-- Right Side Form -->
        <div class="col-md-6 d-flex flex-column justify-content-center align-items-center bg-white p-5">

            <div class="text-center mb-4">
                <img src="~/images/logo.png" style="width:200px;" class="mb-2" />
                <h3>Forgot Password</h3>
                <p class="text-muted">Enter your email to receive OTP</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger w-100" style="max-width:400px;">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success w-100" style="max-width:400px;">
                    @ViewBag.Message
                </div>
            }

            <form method="post" asp-controller="Account" asp-action="SendOTP" style="max-width:400px; width:100%;">

                <div class="mb-3">
                    <label>Email Address</label>
                    <input type="email" name="email" class="form-control" placeholder="Enter your registered email" required />
                </div>

                <button type="submit" class="btn text-white w-100" style="background:#052C65">
                    Send OTP
                </button>

            </form>

            <div class="mt-3">
                <a href="/Account/Login" class="text-muted">Back to Login</a>
            </div>

        </div>

    </div>

</div>