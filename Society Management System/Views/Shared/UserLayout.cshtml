<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background-color: #f4f6f9;
        }

        /* Sidebar */
        .sidebar {
            width: 230px;
            height: 100vh;
            background: #0f2f5f;
            position: fixed;
            color: white;
        }

            .sidebar h3 {
                padding: 20px;
                font-weight: bold;
            }

        .menu a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 20px;
            color: white;
            text-decoration: none;
        }

            .menu a:hover {
                background: #1b3f7a;
            }

        .bottom {
            position: absolute;
            bottom: 20px;
            width: 100%;
        }

        /* Content */
        .content {
            margin-left: 230px;
        }

        /* Top bar */
        .topbar {
            background: #e5e5e5;
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
        }

        /* Cards */
        .card-box {
            background: white;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            box-shadow: 0px 4px 10px rgba(0,0,0,0.1);
            transition: 0.3s;
        }

            .card-box:hover {
                transform: translateY(-5px);
            }

        .card-title {
            font-weight: bold;
            color: #0f2f5f;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        @@media (max-width: 768px) {
            .grid {
                grid-template-columns: 1fr;
            }
       
        }


       .profile-link {
    color: white !important;   /* force white text */
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    text-decoration: none !important; /* remove blue underline */
}

.profile-link i {
    color: white !important;  /* white icon */
    font-size: 20px;
}

.profile-link:hover {
    background: #1b3f7a;
    color: white !important;
}
    }
    </style>
</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <h3>T2P</h3>

        <div class="menu">
            <a href="/User/Dashboard">🏠 Dashboard</a>
            <a href="/User/AddComplain">⚠️ Complain</a>
            <a href="/User/Notice">📁 Notice</a>
            <a href="/User/AddVisitor">👥 Visitor Management</a>
        </div>

        <div class="bottom">
            <a href="/User/Profile" class="menu profile-link">
                <i class="bi bi-person-circle"></i>👤 Profile
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="content">

        <!-- Topbar -->
        <div class="topbar">
            <h5>My Dashboard</h5>
            <a href="/Account/Login">Back to Sing Up</a>
        </div>


        <div class="p-4">
            @RenderBody()
        </div>

    </div>

</body>
</html>