<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - User Dashboard</title>

    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>

    <!-- Sidebar -->
    <ul>
        <li>
            <a asp-controller="User" asp-action="Dashboard">
                <i class="fa-solid fa-chart-line"></i> Dashboard
            </a>
        </li>
        <li>
            <a asp-controller="User" asp-action="AddComplaint">
                <i class="fa-solid fa-triangle-exclamation"></i> Complaint
            </a>
        </li>
        <li>
            <a asp-controller="User" asp-action="Notice">
                <i class="fa-solid fa-bullhorn"></i> Notice
            </a>
        </li>
    </ul>

    <!-- Header -->
    <div class="top-header">
        <div class="profile-right">
            <div class="profile-menu">
                <button class="profile-btn" onclick="toggleMenu()">
                    <i class="fa-solid fa-user"></i>
                    <i class="fa-solid fa-caret-down"></i>
                </button>

                <div class="dropdown-menu" id="profileDropdown">
                    <a asp-controller="Account" asp-action="Profile">My Profile</a>
                    <a asp-controller="Account" asp-action="Logout">Logout</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        @RenderBody()
    </div>

    <script>
        function toggleMenu() {
            document.getElementById("profileDropdown").classList.toggle("show");
        }

        window.onclick = function (event) {
            if (!event.target.closest('.profile-menu')) {
                document.getElementById("profileDropdown").classList.remove("show");
            }
        }
    </script>

</body>
</html>